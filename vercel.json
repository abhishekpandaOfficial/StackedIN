{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/feed", "destination": "/index.html" },
    { "source": "/feed/:path*", "destination": "/index.html" },
    { "source": "/network", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/profile/:path*", "destination": "/index.html" },
    { "source": "/inbox", "destination": "/index.html" },
    { "source": "/write", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/article/:path*", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/publish-scheduled",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
