{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/feed", "destination": "/" },
    { "source": "/feed/:path*", "destination": "/" },
    { "source": "/network", "destination": "/" },
    { "source": "/search", "destination": "/" },
    { "source": "/profile", "destination": "/" },
    { "source": "/profile/:path*", "destination": "/" },
    { "source": "/inbox", "destination": "/" },
    { "source": "/write", "destination": "/" },
    { "source": "/studio", "destination": "/" },
    { "source": "/login", "destination": "/" },
    { "source": "/article/:path*", "destination": "/" },
    { "source": "/Craft", "destination": "/" },
    { "source": "/Craft/:path*", "destination": "/" },
    { "source": "/craft", "destination": "/" },
    { "source": "/craft/:path*", "destination": "/" },
    { "source": "/stackcraft", "destination": "/" },
    { "source": "/stackcraft/:path*", "destination": "/" },
    { "source": "/careeros", "destination": "/" },
    { "source": "/careeros/:path*", "destination": "/" },
    { "source": "/career-os", "destination": "/" },
    { "source": "/career-os/:path*", "destination": "/" },
    { "source": "/career", "destination": "/" },
    { "source": "/career/:path*", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/publish-scheduled",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
